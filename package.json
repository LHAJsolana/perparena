{
  "name": "perparena",
  "version": "0.1.0",
  "description": "Independent simulated risk-adjusted trading competition and analytics prototype.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LHAJsolana/perparena.git"
  },
  "keywords": [
    "solana",
    "defi",
    "perpetual-futures",
    "trading-competition",
    "nextjs",
    "typescript",
    "prisma",
    "postgresql",
    "risk-analytics",
    "portfolio-project"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "simulation:generate": "tsx scripts/generate-simulation.ts",
    "simulation:reset": "tsx scripts/reset-simulation.ts",
    "analytics:recalculate": "tsx scripts/recalculate-analytics.ts",
    "score:recalculate": "tsx scripts/recalculate-scores.ts",
    "score:analyze": "tsx scripts/analyze-score-distribution.ts",
    "integrity:analyze": "tsx scripts/analyze-integrity.ts",
    "integrity:recalculate": "tsx scripts/recalculate-integrity.ts",
    "engagement:recalculate": "tsx scripts/recalculate-engagement.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.4.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    }
  }
}
